# Copy to .env and adjust for your machine.
# Default DATABASE_URL credentials (magnus/magnus) are for local development only — not production.

APP_ENV=development
LOG_LEVEL=INFO

# Async SQLAlchemy URL (runtime). Production (Supabase example):
# postgresql+asyncpg://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://magnus:magnus@localhost:5432/magnus_dev

# Required on Railway when APP_ENV=production — enables Telegram long-polling in magnus-api
TELEGRAM_BOT_TOKEN=

# Railway sets PORT automatically; default 8000 for local `uv run magnus-api`
# PORT=8000

# Future intelligence providers (not required for Day 1)
# OPENAI_API_KEY=

# Not read by magnus-api today (future web client only):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
